# Non-sensitive local bootstrap configuration only.
AIEOS_ENVIRONMENT=local
AIEOS_HOST_NAME=aieos-local
AIEOS_TENANT_ID=local-tenant
AIEOS_WORKSPACE_ID=local-workspace
AIEOS_SECRET_REFERENCE=env://AIEOS_LOCAL_SECRET
AIEOS_RUNTIME_ADAPTER=memory
# Local-only deterministic PostgreSQL URL; never use these credentials outside Compose.
AIEOS_DATABASE_URL=postgresql+asyncpg://aieos:aieos_local@localhost:5432/aieos # pragma: allowlist secret
AIEOS_MIGRATION_MODE=check
AIEOS_OUTBOX_POLL_INTERVAL_SECONDS=0.25
AIEOS_OUTBOX_LEASE_SECONDS=30
AIEOS_OUTBOX_BATCH_SIZE=50
AIEOS_DELIVERY_BACKOFF_SECONDS=1
